{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pxlpeep2",
  "mainBinaryName": "pxlpeep2",
  "version": "26.7.0",
  "identifier": "io.emil.pxlpeep",
  "build": {
    "frontendDist": "../content"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "gif", "webp", "avif", "bmp"],
        "name": "pxlpeep2.image",
        "description": "Image",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
