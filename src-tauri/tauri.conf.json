{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pxlpeep",
  "version": "0.1.0",
  "identifier": "io.github.shaperilio.pxlpeep",
  "build": {
    "frontendDist": "../content"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
